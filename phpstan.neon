includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 8

    paths:
        - app
        - config
        - database
        - routes

    # Register the ide-helper model stubs (IdeHelperXxx classes + @property/@method
    # annotations) as known symbols without analysing the generated file itself.
    # This lets the models' `@mixin IdeHelperXxx` resolve and gives PHPStan the DB
    # column types. Regenerate with `php artisan ide-helper:models -M`.
    scanFiles:
        - _ide_helper_models.php

    # Larastan bootstraps the app to resolve container/facade/Eloquent types.
    #
    # phpstan-baseline.neon is intentionally empty: prefer a real fix over a baseline entry.
    # `composer analyse:baseline` is a last resort for errors that are genuinely unfixable.
